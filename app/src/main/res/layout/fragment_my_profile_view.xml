<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp"
    android:scrollbarSize="0dp"
    tools:context=".presentation.ui.fragments.MyProfileViewFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_back_my_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_left"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tv_title_my_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_profile"
            android:textSize="20sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/gray800"
            app:layout_constraintTop_toTopOf="@id/iv_back_my_profile"
            app:layout_constraintStart_toEndOf="@id/iv_back_my_profile"
            app:layout_constraintBottom_toBottomOf="@id/iv_back_my_profile"
            android:layout_marginStart="20dp"/>

        <TextView
            android:id="@+id/tv_edit_my_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/blue1"
            app:layout_constraintTop_toTopOf="@id/iv_back_my_profile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/iv_back_my_profile"
            android:layout_marginStart="20dp"/>

        <ImageView
            android:id="@+id/iv_profile_my_profile"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/image_profile_in_my_profile"
            android:src="@drawable/image_26"
            android:background="@drawable/bg_iv_profile_oval"
            app:layout_constraintTop_toBottomOf="@id/tv_title_my_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp"/>

        <TextView
            android:id="@+id/tv_title_full_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/full_name"
            android:textSize="16sp"
            android:textColor="@color/gray500"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintTop_toBottomOf="@id/iv_profile_my_profile"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="40dp"/>

        <!-- Full Name TextView -->
        <TextView
            android:id="@+id/tv_full_name_my_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text_login"
            android:padding="12dp"
            android:text="--"
            android:textColor="@color/gray600"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintTop_toBottomOf="@id/tv_title_full_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_title_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/position"
            android:textSize="16sp"
            android:textColor="@color/gray500"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintTop_toBottomOf="@id/tv_full_name_my_profile"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="10dp"/>

        <!-- Position TextView -->
        <TextView
            android:id="@+id/tv_position_my_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text_login"
            android:padding="12dp"
            android:text="--"
            android:textColor="@color/gray600"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintTop_toBottomOf="@id/tv_title_position"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_title_gender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gender"
            android:textSize="16sp"
            android:textColor="@color/gray500"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintTop_toBottomOf="@id/tv_position_my_profile"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="10dp"/>

        <!-- Gender TextView -->
        <TextView
            android:id="@+id/tv_gender_my_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text_login"
            android:padding="12dp"
            android:text="--"
            android:textColor="@color/gray600"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintTop_toBottomOf="@id/tv_title_gender"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_title_birth_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/birth_date"
            android:textSize="16sp"
            android:textColor="@color/gray500"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintTop_toBottomOf="@id/tv_gender_my_profile"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="10dp"/>

        <!-- Birth Date TextView -->
        <TextView
            android:id="@+id/tv_birth_date_my_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text_login"
            android:padding="12dp"
            android:text="--"
            android:textColor="@color/gray600"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintTop_toBottomOf="@id/tv_title_birth_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_title_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/phone"
            android:textSize="16sp"
            android:textColor="@color/gray500"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintTop_toBottomOf="@id/tv_birth_date_my_profile"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="10dp"/>

        <!-- Phone TextView -->
        <TextView
            android:id="@+id/tv_phone_my_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text_login"
            android:padding="12dp"
            android:text="--"
            android:textColor="@color/gray600"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintTop_toBottomOf="@id/tv_title_phone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_title_religion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/religion"
            android:textSize="16sp"
            android:textColor="@color/gray500"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintTop_toBottomOf="@id/tv_phone_my_profile"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="10dp"/>

        <!-- Religion TextView -->
        <TextView
            android:id="@+id/tv_religion_my_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text_login"
            android:padding="12dp"
            android:text="--"
            android:textColor="@color/gray600"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintTop_toBottomOf="@id/tv_title_religion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
